# Ignore by path, never by a broad name pattern: `*checkpoint*` once swallowed a source file (LEARNINGS).

# Secrets: never commit
.env
*.key

# Generated: nothing generated is tracked (data/, outputs/, builds)
/data/
/outputs/
/dist*/
build/
*.egg-info/
*.pkl
*.pickle

# Python, venv and notebook caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
.ipynb_checkpoints/

# OS and editors
.DS_Store
.vscode/
.idea/
*.swp
