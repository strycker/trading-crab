# Copy this file to .env and fill in your keys. .env is ignored by git: never commit real keys.
# An exported environment variable wins over the same name in .env.

# FRED (macro series): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Tiingo free tier (ETF prices): https://www.tiingo.com/account/api/token
TIINGO_API_KEY=
